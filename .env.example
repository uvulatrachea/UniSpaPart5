APP_NAME=UniSpa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database — must match docker-compose.yml ───
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=unispa
DB_USERNAME=sail
DB_PASSWORD=password
DB_SSLMODE=disable

# ─── Session ───
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# ─── Mail (optional) ───
# Leave as-is to disable. To enable real emails:
#   1. Enable 2FA on your Gmail account
#   2. Go to https://myaccount.google.com/apppasswords and create an App Password
#   3. Replace values below with your Gmail and App Password
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD="your_16_char_app_password"
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="UniSpa"
MAIL_ENCRYPTION=tls

# ─── Admin seeder credentials ───
ADMIN_EMAIL=admin@unispa.com
ADMIN_PASSWORD=Admin12345!

VITE_APP_NAME="${APP_NAME}"
